
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ultra Realistic Space</title>

<style>
* { box-sizing: border-box; }

html, body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #01030a;
    font-family: Arial, sans-serif;
}

canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: none;
}

canvas:active { cursor: grabbing; }

#info {
    position: fixed;
    left: 22px;
    top: 20px;
    z-index: 2;
    color: #d9eaff;
    pointer-events: none;
    text-shadow: 0 0 12px #247dff;
}

#info h1 {
    font-size: clamp(16px, 2vw, 24px);
    letter-spacing: 4px;
    margin: 0 0 8px;
}

#info p {
    font-size: 10px;
    letter-spacing: 2px;
    opacity: .75;
}

#hint {
    position: fixed;
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    color: #c6dcff;
    font-size: 11px;
    letter-spacing: 1px;
    white-space: nowrap;
    opacity: .7;
    pointer-events: none;
}

#status {
    position: fixed;
    top: 20px;
    right: 20px;
    color: #8ddcff;
    font-size: 10px;
    letter-spacing: 2px;
    pointer-events: none;
}

@media(max-width:600px) {
    #info { left: 12px; top: 14px; }
    #info h1 { letter-spacing: 2px; }
    #status { right: 12px; top: 15px; font-size: 8px; }
    #hint { font-size: 9px; bottom: 12px; }
}
</style>
</head>

<body>

<div id="info">
    <h1>DEEP SPACE</h1>
    <p>ASTEROID FIELD // DEEP UNIVERSE</p>
</div>

<div id="status">LIVE SIMULATION</div>
<div id="hint">DRAG TO EXPLORE · TANPA ZOOM</div>

<script type="importmap">
{
  "imports": {
    "three": "https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js"
  }
}
</script>

<script type="module">
import * as THREE from "three";

/* ==================================================
   1. PENGATURAN UTAMA
   Ubah angka di bagian ini untuk mengatur animasi.
================================================== */

const SETTINGS = {
    // Jumlah asteroid. Naikkan jika ingin lebih padat.
    asteroidCount: 1800,

    // Jumlah bintang di latar belakang.
    starCount: 3500,

    // Ukuran planet.
    planetRadius: 7,

    // Kecepatan rotasi planet.
    planetRotation: 0.045,

    // Kecepatan orbit asteroid.
    asteroidSpeed: 0.075,

    // Kecepatan rotasi batu asteroid.
    asteroidRotation: 0.35,

    // Jumlah bintang jatuh yang aktif.
    shootingStarCount: 5,

    // Intensitas cahaya utama.
    sunlight: 3.5,

    // Sensitivitas geser mouse.
    dragSensitivity: 0.004,

    // Kecepatan pergerakan bintang.
    starMotion: 0.35
};

/* ==================================================
   2. MEMBUAT SCENE DAN KAMERA
================================================== */

const scene = new THREE.Scene();

scene.background = new THREE.Color("#01030a");

scene.fog = new THREE.FogExp2("#01030a", 0.0018);

const camera = new THREE.PerspectiveCamera(
    55,
    window.innerWidth / window.innerHeight,
    0.1,
    2000
);

const INITIAL_DISTANCE = 36;
camera.position.set(0, 3, INITIAL_DISTANCE);

/* ==================================================
   3. RENDERER
================================================== */

const renderer = new THREE.WebGLRenderer({
    antialias: true,
    powerPreference: "high-performance"
});

renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));

renderer.outputColorSpace = THREE.SRGBColorSpace;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.25;

document.body.prepend(renderer.domElement);

/* ==================================================
   4. PENCERAHAN RUANG ANGKASA
================================================== */

scene.add(new THREE.AmbientLight(0x253858, 0.75));

const sunlight = new THREE.DirectionalLight(
    0xc7e8ff,
    SETTINGS.sunlight
);

sunlight.position.set(-15, 12, 20);
scene.add(sunlight);

const blueLight = new THREE.PointLight(
    0x087cff, 45, 90, 2
);

blueLight.position.set(-12, 3, 8);
scene.add(blueLight);

const purpleLight = new THREE.PointLight(
    0x5a27ff, 25, 75, 2
);

purpleLight.position.set(12, -5, -15);
scene.add(purpleLight);

/* ==================================================
   5. PLANET DENGAN TEKSTUR PROSEDURAL
================================================== */

function createPlanetTexture() {
    const c = document.createElement("canvas");
    c.width = 1024;
    c.height = 512;

    const g = c.getContext("2d");

    const base = g.createLinearGradient(0, 0, 0, 512);
    base.addColorStop(0, "#071b48");
    base.addColorStop(0.25, "#1473bd");
    base.addColorStop(0.5, "#06285d");
    base.addColorStop(0.72, "#1252a0");
    base.addColorStop(1, "#030b26");

    g.fillStyle = base;
    g.fillRect(0, 0, 1024, 512);

    // Pita atmosferik dan awan.
    for (let i = 0; i < 1000; i++) {
        const x = Math.random() * 1024;
        const y = Math.random() * 512;
        const w = 10 + Math.random() * 140;
        const h = 1 + Math.random() * 8;

        const bright = Math.random();

        g.fillStyle = bright > 0.5
            ? `rgba(120,210,255,${Math.random() * 0.15})`
            : `rgba(0,5,30,${Math.random() * 0.18})`;

        g.beginPath();
        g.ellipse(x, y, w, h, Math.random() * 0.2, 0, Math.PI * 2);
        g.fill();
    }

    // Bercak badai.
    for (let i = 0; i < 35; i++) {
        const x = Math.random() * 1024;
        const y = Math.random() * 512;

        g.beginPath();
        g.ellipse(
            x, y,
            8 + Math.random() * 35,
            3 + Math.random() * 12,
            Math.random(),
            0, Math.PI * 2
        );

        g.fillStyle = "rgba(145,220,255,0.13)";
        g.fill();
    }

    const texture = new THREE.CanvasTexture(c);
    texture.colorSpace = THREE.SRGBColorSpace;
    texture.wrapS = THREE.RepeatWrapping;
    texture.anisotropy = 4;

    return texture;
}

const planetGroup = new THREE.Group();
scene.add(planetGroup);

const planetGeometry = new THREE.SphereGeometry(
    SETTINGS.planetRadius, 128, 96
);

const planetMaterial = new THREE.MeshStandardMaterial({
    map: createPlanetTexture(),
    roughness: 0.82,
    metalness: 0.05
});

const planet = new THREE.Mesh(
    planetGeometry,
    planetMaterial
);

planetGroup.add(planet);

// Atmosfer berupa beberapa lapisan transparan.
const atmosphere = new THREE.Mesh(
    new THREE.SphereGeometry(
        SETTINGS.planetRadius * 1.035, 96, 64
    ),
    new THREE.MeshBasicMaterial({
        color: 0x168cff,
        transparent: true,
        opacity: 0.11,
        side: THREE.BackSide,
        blending: THREE.AdditiveBlending,
        depthWrite: false
    })
);

planetGroup.add(atmosphere);

const outerGlow = new THREE.Mesh(
    new THREE.SphereGeometry(
        SETTINGS.planetRadius * 1.09, 64, 48
    ),
    new THREE.MeshBasicMaterial({
        color: 0x076bff,
        transparent: true,
        opacity: 0.045,
        side: THREE.BackSide,
        blending: THREE.AdditiveBlending,
        depthWrite: false
    })
);

planetGroup.add(outerGlow);

// Sedikit kemiringan planet.
planetGroup.rotation.z = -0.15;
planetGroup.rotation.x = 0.12;

/* ==================================================
   6. CINCIN PLANET
================================================== */

const ringGeometry = new THREE.RingGeometry(
    SETTINGS.planetRadius * 1.3,
    SETTINGS.planetRadius * 2.25,
    256
);

// Buat tekstur cincin berlapis.
function createRingTexture() {
    const c = document.createElement("canvas");
    c.width = 1024;
    c.height = 32;

    const g = c.getContext("2d");

    for (let x = 0; x < c.width; x++) {
        const n = Math.random();

        g.fillStyle = n > 0.78
            ? `rgba(165,205,255,${0.15 + Math.random() * 0.65})`
            : n > 0.48
            ? `rgba(75,110,165,${0.1 + Math.random() * 0.4})`
            : `rgba(8,20,48,${0.3 + Math.random() * 0.65})`;

        g.fillRect(x, 0, 1, 32);
    }

    const texture = new THREE.CanvasTexture(c);
    texture.colorSpace = THREE.SRGBColorSpace;

    return texture;
}

const ringMaterial = new THREE.MeshStandardMaterial({
    map: createRingTexture(),
    color: 0x8ba9d2,
    side: THREE.DoubleSide,
    transparent: true,
    opacity: 0.85,
    roughness: 0.85,
    metalness: 0.15,
    depthWrite: false
});

const ring = new THREE.Mesh(ringGeometry, ringMaterial);

ring.rotation.x = Math.PI / 2.45;
ring.rotation.y = 0.18;
ring.rotation.z = -0.15;

planetGroup.add(ring);

/* ==================================================
   7. ASTEROID BELT
================================================== */

const asteroidGroup = new THREE.Group();
scene.add(asteroidGroup);

const asteroidGeometry = new THREE.IcosahedronGeometry(1, 1);

// Buat beberapa bentuk batu yang berbeda.
const asteroidShapes = [];

for (let i = 0; i < 10; i++) {
    const geo = new THREE.IcosahedronGeometry(
        0.7 + Math.random() * 0.6,
        i % 3 === 0 ? 2 : 1
    );

    const pos = geo.attributes.position;

    for (let j = 0; j < pos.count; j++) {
        const distortion = 0.78 + Math.random() * 0.42;

        pos.setXYZ(
            j,
            pos.getX(j) * distortion,
            pos.getY(j) * distortion,
            pos.getZ(j) * distortion
        );
    }

    geo.computeVertexNormals();
    asteroidShapes.push(geo);
}

const asteroidMaterials = [
    new THREE.MeshStandardMaterial({
        color: 0x71675e, roughness: 1
    }),
    new THREE.MeshStandardMaterial({
        color: 0x393e49, roughness: 0.96
    }),
    new THREE.MeshStandardMaterial({
        color: 0x9a826b, roughness: 1
    }),
    new THREE.MeshStandardMaterial({
        color: 0x515967, roughness: 0.9
    }),
    new THREE.MeshStandardMaterial({
        color: 0x252b37, roughness: 1
    })
];

const asteroidData = [];
const asteroidMeshes = [];

for (let i = 0; i < SETTINGS.asteroidCount; i++) {
    const geo = asteroidShapes[
        Math.floor(Math.random() * asteroidShapes.length)
    ];

    const mat = asteroidMaterials[
        Math.floor(Math.random() * asteroidMaterials.length)
    ];

    const asteroid = new THREE.Mesh(geo, mat);

    // Jarak dari pusat planet.
    const orbitRadius = 12.5 + Math.random() * 13;

    const angle = Math.random() * Math.PI * 2;

    // Tinggi orbit berbeda-beda.
    const vertical = (Math.random() - 0.5) * 4.2;

    const size = 0.08 + Math.pow(Math.random(), 2) * 0.7;

    asteroid.position.set(
        Math.cos(angle) * orbitRadius,
        vertical,
        Math.sin(angle) * orbitRadius
    );

    asteroid.scale.set(
        size * (0.7 + Math.random() * 0.8),
        size * (0.6 + Math.random() * 0.9),
        size * (0.7 + Math.random() * 0.8)
    );

    asteroid.rotation.set(
        Math.random() * 6.28,
        Math.random() * 6.28,
        Math.random() * 6.28
    );

    asteroidGroup.add(asteroid);
    asteroidMeshes.push(asteroid);

    asteroidData.push({
        angle,
        orbitRadius,
        vertical,
        size,
        speed: SETTINGS.asteroidSpeed *
            (0.35 + Math.random() * 1.4) *
            (Math.random() < 0.5 ? -1 : 1),
        rotationX: (Math.random() - 0.5) *
            SETTINGS.asteroidRotation,
        rotationY: (Math.random() - 0.5) *
            SETTINGS.asteroidRotation,
        rotationZ: (Math.random() - 0.5) *
            SETTINGS.asteroidRotation,
        phase: Math.random() * 6.28
    });
}

/* ==================================================
   8. BINTANG-BINTANG YANG BERCAHAYA
================================================== */

const starPositions = new Float32Array(
    SETTINGS.starCount * 3
);

const starSizes = new Float32Array(
    SETTINGS.starCount
);

for (let i = 0; i < SETTINGS.starCount; i++) {
    const radius = 100 + Math.random() * 650;

    const theta = Math.random() * Math.PI * 2;
    const phi = Math.acos(2 * Math.random() - 1);

    starPositions[i * 3] =
        radius * Math.sin(phi) * Math.cos(theta);

    starPositions[i * 3 + 1] =
        radius * Math.cos(phi);

    starPositions[i * 3 + 2] =
        radius * Math.sin(phi) * Math.sin(theta);

    starSizes[i] = Math.random();
}

const starGeometry = new THREE.BufferGeometry();

starGeometry.setAttribute(
    "position",
    new THREE.BufferAttribute(starPositions, 3)
);

const starMaterial = new THREE.PointsMaterial({
    color: 0xcbe5ff,
    size: 0.9,
    sizeAttenuation: true,
    transparent: true,
    opacity: 0.95,
    blending: THREE.AdditiveBlending,
    depthWrite: false
});

const starField = new THREE.Points(
    starGeometry, starMaterial
);

scene.add(starField);

// Bintang besar yang berkilau.
const brightStars = new THREE.Group();
scene.add(brightStars);

for (let i = 0; i < 90; i++) {
    const star = new THREE.Group();

    const radius = 65 + Math.random() * 160;
    const theta = Math.random() * Math.PI * 2;
    const phi = Math.acos(2 * Math.random() - 1);

    star.position.set(
        radius * Math.sin(phi) * Math.cos(theta),
        radius * Math.cos(phi),
        radius * Math.sin(phi) * Math.sin(theta)
    );

    const size = 0.08 + Math.random() * 0.15;

    const dot = new THREE.Mesh(
        new THREE.SphereGeometry(size, 8, 8),
        new THREE.MeshBasicMaterial({
            color: i % 4 === 0 ? 0x77caff : 0xffffff
        })
    );

    star.add(dot);

    // Sinar horizontal dan vertikal.
    const flareMaterial = new THREE.LineBasicMaterial({
        color: 0x91cfff,
        transparent: true,
        opacity: 0.65
    });

    for (let k = 0; k < 2; k++) {
        const points = k === 0
            ? [
                new THREE.Vector3(-size * 7, 0, 0),
                new THREE.Vector3(size * 7, 0, 0)
            ]
            : [
                new THREE.Vector3(0, -size * 7, 0),
                new THREE.Vector3(0, size * 7, 0)
            ];

        star.add(new THREE.Line(
            new THREE.BufferGeometry().setFromPoints(points),
            flareMaterial
        ));
    }

    star.userData.phase = Math.random() * 6.28;
    star.userData.speed = 0.8 + Math.random() * 2;

    brightStars.add(star);
}

/* ==================================================
   9. BINTANG JATUH
================================================== */

const shootingStars = [];

function createShootingStar() {
    const group = new THREE.Group();

    const material = new THREE.LineBasicMaterial({
        color: 0x8ddaff,
        transparent: true,
        opacity: 0.95,
        blending: THREE.AdditiveBlending
    });

    const points = [
        new THREE.Vector3(0, 0, 0),
        new THREE.Vector3(-4, 0.8, 0)
    ];

    const line = new THREE.Line(
        new THREE.BufferGeometry().setFromPoints(points),
        material
    );

    group.add(line);

    const head = new THREE.Mesh(
        new THREE.SphereGeometry(0.055, 8, 8),
        new THREE.MeshBasicMaterial({
            color: 0xffffff
        })
    );

    group.add(head);
    scene.add(group);

    return {
        group,
        line,
        head,
        velocity: new THREE.Vector3(),
        life: 0,
        delay: Math.random() * 5,
        active: false
    };
}

for (let i = 0; i < SETTINGS.shootingStarCount; i++) {
    shootingStars.push(createShootingStar());
}

function launchShootingStar(s) {
    s.group.position.set(
        (Math.random() - 0.5) * 100,
        25 + Math.random() * 35,
        -20 - Math.random() * 90
    );

    s.velocity.set(
        -0.8 - Math.random() * 1.5,
        -0.7 - Math.random() * 1.3,
        0.1 + Math.random() * 0.4
    );

    s.life = 0;
    s.active = true;
}

function updateShootingStars(dt) {
    for (const s of shootingStars) {
        if (!s.active) {
            s.delay -= dt;

            if (s.delay <= 0) {
                launchShootingStar(s);
            }

            continue;
        }

        s.group.position.addScaledVector(s.velocity, dt);
        s.life += dt;

        s.line.material.opacity =
            Math.max(0, 1 - s.life / 2.3);

        if (s.life > 2.3) {
            s.active = false;
            s.delay = 1 + Math.random() * 7;
        }
    }
}

/* ==================================================
   10. KONTROL KAMERA TANPA ZOOM
================================================== */

let yaw = 0;
let pitch = 0.06;

let targetYaw = 0;
let targetPitch = 0.06;

let dragging = false;
let lastX = 0;
let lastY = 0;

renderer.domElement.addEventListener(
    "pointerdown", (event) => {
        dragging = true;
        lastX = event.clientX;
        lastY = event.clientY;

        renderer.domElement.setPointerCapture(event.pointerId);
    }
);

renderer.domElement.addEventListener(
    "pointermove", (event) => {
        if (!dragging) return;

        const dx = event.clientX - lastX;
        const dy = event.clientY - lastY;

        targetYaw -= dx * SETTINGS.dragSensitivity;
        targetPitch -= dy * SETTINGS.dragSensitivity;

        targetPitch = THREE.MathUtils.clamp(
            targetPitch, -1.25, 1.25
        );

        lastX = event.clientX;
        lastY = event.clientY;
    }
);

function stopDragging() {
    dragging = false;
}

renderer.domElement.addEventListener(
    "pointerup", stopDragging
);

renderer.domElement.addEventListener(
    "pointercancel", stopDragging
);

renderer.domElement.addEventListener(
    "contextmenu", event => event.preventDefault()
);

// Mengunci jarak kamera supaya tidak zoom.
function updateCamera() {
    yaw += (targetYaw - yaw) * 0.12;
    pitch += (targetPitch - pitch) * 0.12;

    const distance = INITIAL_DISTANCE;

    camera.position.set(
        Math.sin(yaw) * Math.cos(pitch) * distance,
        Math.sin(pitch) * distance + 1.5,
        Math.cos(yaw) * Math.cos(pitch) * distance
    );

    camera.lookAt(0, 0, 0);
}

/* ==================================================
   11. ANIMASI UTAMA
================================================== */

const clock = new THREE.Clock();

function animate() {
    requestAnimationFrame(animate);

    const dt = Math.min(clock.getDelta(), 0.05);
    const time = clock.elapsedTime;

    // Planet berputar perlahan.
    planet.rotation.y += SETTINGS.planetRotation * dt;

    // Cincin berputar sedikit.
    ring.rotation.z += 0.006 * dt;

    // Orbit dan rotasi setiap asteroid.
    for (let i = 0; i < asteroidMeshes.length; i++) {
        const a = asteroidData[i];
        const rock = asteroidMeshes[i];

        a.angle += a.speed * dt * 0.1;

        rock.position.x =
            Math.cos(a.angle) * a.orbitRadius;

        rock.position.z =
            Math.sin(a.angle) * a.orbitRadius;

        rock.position.y =
            a.vertical + Math.sin(time * 0.3 + a.phase) * 0.12;

        rock.rotation.x += a.rotationX * dt;
        rock.rotation.y += a.rotationY * dt;
        rock.rotation.z += a.rotationZ * dt;
    }

    // Latar bintang bergerak sangat perlahan.
    starField.rotation.y += SETTINGS.starMotion * dt * 0.002;
    starField.rotation.x += SETTINGS.starMotion * dt * 0.0003;

    // Kilauan bintang besar.
    for (const star of brightStars.children) {
        const pulse = 0.7 + 0.3 * Math.sin(
            time * star.userData.speed + star.userData.phase
        );

        star.scale.setScalar(pulse);
        star.rotation.z += dt * 0.03;
    }

    updateShootingStars(dt);
    updateCamera();

    renderer.render(scene, camera);
}

window.addEventListener("resize", () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();

    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));
});

animate();
</script>
</body>
</html>
